@model Maintenance
@{
    ViewData["Title"] = "Tạo bảo trì";
    var fields = ViewBag.Fields as List<FootballField> ?? [];
}
<h2>Tạo lịch bảo trì</h2>
<form class="panel p-4" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="search-grid">
        <div class="field"><label>Sân</label>
            <select asp-for="FieldId">
                @foreach (var field in fields)
                {
                    <option value="@field.Id">@field.FieldCode - @field.Name</option>
                }
            </select>
        </div>
        <div class="field"><label>Tiêu đề</label><input asp-for="Title" /><span asp-validation-for="Title" class="validation"></span></div>
        <div class="field"><label>Bắt đầu</label><input asp-for="StartDateTime" type="datetime-local" /></div>
        <div class="field"><label>Kết thúc</label><input asp-for="EndDateTime" type="datetime-local" /><span asp-validation-for="EndDateTime" class="validation"></span></div>
        <div class="field"><label>Chi phí</label><input asp-for="Cost" /></div>
        <div class="field"><label>Trạng thái</label>
            <select asp-for="Status">
                @foreach (MaintenanceStatus status in Enum.GetValues(typeof(MaintenanceStatus)))
                {
                    <option value="@status">@status.Text()</option>
                }
            </select>
        </div>
        <div class="field full"><label>Mô tả</label><textarea asp-for="Description" rows="3"></textarea></div>
    </div>
    <button class="btn btn-green mt-3" type="submit">Lưu</button>
</form>
