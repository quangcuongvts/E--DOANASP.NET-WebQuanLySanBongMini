@model ServiceItem
@{
    ViewData["Title"] = "Sửa dịch vụ";
}
<h2>Sửa @Model.Name</h2>
<form class="panel p-4" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="field"><label>Tên</label><input asp-for="Name" /></div>
    <div class="field mt-2"><label>Mô tả</label><textarea asp-for="Description" rows="3"></textarea></div>
    <div class="field mt-2"><label>Giá</label><input asp-for="Price" /></div>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="" style="width:120px;border-radius:8px" />
    }
    <div class="field mt-2"><label>Ảnh mới</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif" /></div>
    <label class="mt-2"><input asp-for="IsActive" /> Đang kinh doanh</label>
    <div><button class="btn btn-green mt-3" type="submit">Lưu</button></div>
</form>
