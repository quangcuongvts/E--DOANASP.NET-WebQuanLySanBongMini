@model ServiceItem
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm dịch vụ" : "Sửa dịch vụ";
}
<h2>@ViewData["Title"]</h2>
<form class="panel p-4" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <input type="hidden" asp-for="Id" />
    <div class="field"><label>Tên</label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span></div>
    <div class="field mt-2"><label>Mô tả</label><textarea asp-for="Description" rows="3"></textarea></div>
    <div class="field mt-2"><label>Giá</label><input asp-for="Price" /><span asp-validation-for="Price" class="validation"></span></div>
    <div class="field mt-2"><label>Ảnh</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif" /></div>
    <label class="mt-2"><input asp-for="IsActive" /> Đang kinh doanh</label>
    <div><button class="btn btn-green mt-3" type="submit">Lưu</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
