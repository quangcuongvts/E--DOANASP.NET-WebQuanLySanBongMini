@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager") || isAdmin;
    var title = ViewData["Title"]?.ToString() ?? "Bảng điều khiển";
    var compactLogo = new ViewDataDictionary(ViewData) { ["LogoCompact"] = true };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Mini Football</title>
    <link rel="icon" href="~/images/logo.svg" type="image/svg+xml" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="sidebar">
            <a class="side-brand" asp-controller="Dashboard" asp-action="Index"><partial name="_Logo" view-data="compactLogo" /></a>
            <a class="side-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid"></i><span class="label">Dashboard</span></a>
            <div class="group-title">QUẢN LÝ</div>
            <a class="side-link @Active("Fields")" asp-controller="Fields" asp-action="Index"><i class="bi bi-dribbble"></i><span class="label">Sân bóng</span></a>
            @if (isManager)
            {
                <a class="side-link @Active("FieldTypes")" asp-controller="FieldTypes" asp-action="Index"><i class="bi bi-diagram-3"></i><span class="label">Loại sân</span></a>
            }
            <a class="side-link @Active("Schedules")" asp-controller="Schedules" asp-action="Index"><i class="bi bi-calendar3"></i><span class="label">Lịch sân</span></a>
            <a class="side-link @Active("Bookings")" asp-controller="Bookings" asp-action="Index"><i class="bi bi-journal-check"></i><span class="label">Booking</span></a>
            <a class="side-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i><span class="label">Khách hàng</span></a>
            @if (isManager)
            {
                <a class="side-link @Active("Staffs")" asp-controller="Staffs" asp-action="Index"><i class="bi bi-person-badge"></i><span class="label">Nhân viên</span></a>
            }
            <div class="group-title">KINH DOANH</div>
            <a class="side-link @Active("Payments")" asp-controller="Payments" asp-action="Index"><i class="bi bi-cash-stack"></i><span class="label">Thanh toán</span></a>
            @if (isManager)
            {
                <a class="side-link @Active("Services")" asp-controller="Services" asp-action="Index"><i class="bi bi-bag"></i><span class="label">Dịch vụ</span></a>
                <a class="side-link @Active("Vouchers")" asp-controller="Vouchers" asp-action="Index"><i class="bi bi-ticket-perforated"></i><span class="label">Voucher</span></a>
                <a class="side-link @Active("PriceRules")" asp-controller="PriceRules" asp-action="Index"><i class="bi bi-tags"></i><span class="label">Bảng giá</span></a>
                <div class="group-title">HỆ THỐNG</div>
                <a class="side-link @Active("Reviews")" asp-controller="Reviews" asp-action="Index"><i class="bi bi-star"></i><span class="label">Review</span></a>
                <a class="side-link @Active("Maintenances")" asp-controller="Maintenances" asp-action="Index"><i class="bi bi-tools"></i><span class="label">Bảo trì</span></a>
            }
            @if (isAdmin)
            {
                <a class="side-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i><span class="label">Người dùng</span></a>
                <a class="side-link @Active("Roles")" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i><span class="label">Phân quyền</span></a>
                <a class="side-link @Active("Posts")" asp-controller="Posts" asp-action="Index"><i class="bi bi-newspaper"></i><span class="label">Bài viết</span></a>
                <a class="side-link @Active("Banners")" asp-controller="Banners" asp-action="Index"><i class="bi bi-image"></i><span class="label">Banner</span></a>
                <a class="side-link @Active("Contacts")" asp-controller="Contacts" asp-action="Index"><i class="bi bi-envelope"></i><span class="label">Liên hệ</span></a>
                <a class="side-link @Active("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-clock-history"></i><span class="label">Audit Log</span></a>
                <a class="side-link @Active("Settings")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span class="label">Cấu hình</span></a>
            }
            @if (isManager)
            {
                <div class="group-title">BÁO CÁO</div>
                <a class="side-link" asp-controller="Reports" asp-action="Revenue"><i class="bi bi-graph-up"></i><span class="label">Doanh thu</span></a>
                <a class="side-link" asp-controller="Reports" asp-action="Bookings"><i class="bi bi-bar-chart"></i><span class="label">Booking</span></a>
                <a class="side-link" asp-controller="Reports" asp-action="Customers"><i class="bi bi-person-lines-fill"></i><span class="label">Khách hàng</span></a>
                <a class="side-link" asp-controller="Reports" asp-action="Performance"><i class="bi bi-speedometer2"></i><span class="label">Hiệu suất sân</span></a>
            }
        </aside>
        <div class="admin-main">
            <div class="topbar">
                <button class="icon-btn" type="button" data-sidebar><i class="bi bi-layout-sidebar"></i></button>
                <div>
                    <div class="crumb">Hệ thống đặt sân bóng mini / @title</div>
                    <strong>@title</strong>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @await Component.InvokeAsync("NotificationBell")
                    <a class="btn btn-line btn-sm" asp-area="" asp-controller="Home" asp-action="Index">Xem website</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-dark btn-sm" type="submit">Đăng xuất</button>
                    </form>
                </div>
            </div>
            <div class="admin-content">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @if (TempData["Success"] != null)
    {
        <script>window.tempSuccess = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString()));</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>window.tempError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString()));</script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
