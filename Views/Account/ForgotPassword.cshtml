@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth-wrap">
    <form class="auth-card" method="post">
        @Html.AntiForgeryToken()
        <h2>Quên mật khẩu</h2>
        <p class="muted">Môi trường đồ án không gửi email. Liên kết đặt lại sẽ hiện ngay sau khi kiểm tra email.</p>
        <div class="field"><label>Email</label><input asp-for="Email" /><span asp-validation-for="Email" class="validation"></span></div>
        <button class="btn btn-green w-100 mt-3" type="submit">Lấy liên kết</button>
    </form>
</div>
