@model CustomerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ";
}
<section class="page-hero"><div class="container"><h1>Hồ sơ cá nhân</h1></div></section>
<div class="container section">
    <form class="panel p-4" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="avatar" class="avatar" style="width:72px;height:72px" />
        }
        <div class="field mt-2"><label>Ảnh đại diện</label><input type="file" name="avatar" accept=".jpg,.jpeg,.png,.webp,.gif" /></div>
        <div class="search-grid mt-3">
            <div class="field"><label>Họ tên</label><input asp-for="FullName" /><span asp-validation-for="FullName" class="validation"></span></div>
            <div class="field"><label>Email</label><input asp-for="Email" /><span asp-validation-for="Email" class="validation"></span></div>
            <div class="field"><label>Số điện thoại</label><input asp-for="Phone" /><span asp-validation-for="Phone" class="validation"></span></div>
            <div class="field"><label>Ngày sinh</label><input asp-for="DateOfBirth" type="date" /></div>
            <div class="field"><label>Giới tính</label>
                <select asp-for="Gender">
                    <option value="@Gender.Male">Nam</option>
                    <option value="@Gender.Female">Nữ</option>
                    <option value="@Gender.Other">Khác</option>
                </select>
            </div>
            <div class="field"><label>Địa chỉ</label><input asp-for="Address" /></div>
        </div>
        <button class="btn btn-green mt-3" type="submit">Lưu hồ sơ</button>
        <a class="btn btn-line mt-3" asp-action="ChangePassword">Đổi mật khẩu</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
