@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="auth-wrap">
    <form class="auth-card" method="post">
        @Html.AntiForgeryToken()
        <h2>Đổi mật khẩu</h2>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <div class="field"><label>Mật khẩu hiện tại</label><input asp-for="CurrentPassword" /><span asp-validation-for="CurrentPassword" class="validation"></span></div>
        <div class="field mt-2"><label>Mật khẩu mới</label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword" class="validation"></span></div>
        <div class="field mt-2"><label>Xác nhận</label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="validation"></span></div>
        <button class="btn btn-green w-100 mt-3" type="submit">Cập nhật</button>
    </form>
</div>
