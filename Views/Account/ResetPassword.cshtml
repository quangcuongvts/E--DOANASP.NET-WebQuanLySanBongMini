@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="auth-wrap">
    <form class="auth-card" method="post">
        @Html.AntiForgeryToken()
        <h2>Mật khẩu mới</h2>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div class="field"><label>Mật khẩu mới</label><input asp-for="Password" /><span asp-validation-for="Password" class="validation"></span></div>
        <div class="field mt-2"><label>Xác nhận</label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="validation"></span></div>
        <button class="btn btn-green w-100 mt-3" type="submit">Cập nhật</button>
    </form>
</div>
