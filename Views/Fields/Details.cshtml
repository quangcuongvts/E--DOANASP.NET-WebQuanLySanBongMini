@model FieldDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}
<section class="page-hero"><div class="container"><div class="meta">@Model.FieldCode · @Model.Area</div><h1>@Model.Name</h1></div></section>
<div class="container section">
    <div class="gallery mb-4">
        <img src="@(Model.Images.FirstOrDefault() ?? "/images/field.svg")" alt="@Model.Name" style="min-height:320px" onerror="this.src='/images/field.svg'" />
        <div class="thumbs">
            @foreach (var image in Model.Images.Skip(1).Take(2))
            {
                <img src="@image" alt="" style="height:155px" onerror="this.src='/images/field.svg'" />
            }
        </div>
    </div>
    <div class="detail-grid">
        <div>
            <span class="status @Model.DisplayStatus.Css()">@Model.DisplayStatus.Text()</span>
            <p class="mt-3">@Model.Description</p>
            <div class="card-grid">
                <div class="amenity">Loại sân: @Model.TypeName</div>
                <div class="amenity">Số người: @Model.Capacity</div>
                <div class="amenity">Kích thước: @Model.Length x @Model.Width m</div>
                <div class="amenity">Mặt sân: @Model.SurfaceType</div>
                <div class="amenity">Chiếu sáng: @(Model.HasLighting ? "Có" : "Không")</div>
                <div class="amenity">Phòng thay đồ: @(Model.HasChangingRoom ? "Có" : "Không")</div>
                <div class="amenity">Nhà vệ sinh: @(Model.HasToilet ? "Có" : "Không")</div>
                <div class="amenity">Gửi xe: @(Model.HasParking ? "Có" : "Không")</div>
                <div class="amenity">Wifi: @(Model.HasWifi ? "Có" : "Không")</div>
                <div class="amenity">Nước uống: @(Model.HasWater ? "Có" : "Không")</div>
            </div>
            <h3 class="mt-4">Bảng giá @DisplayNames.DayName((int)Model.SelectedDate.DayOfWeek)</h3>
            <div class="table-card">
                <table>
                    <tr><th>Khung giờ</th><th>Giá / giờ</th><th></th></tr>
                    @foreach (var rule in Model.PriceRules)
                    {
                        <tr>
                            <td>@DisplayNames.Hours(rule.StartTime, rule.EndTime)</td>
                            <td>@rule.PricePerHour.VndText()</td>
                            <td>@(rule.IsPeakHour ? "Cao điểm" : "Giờ thường")</td>
                        </tr>
                    }
                </table>
            </div>
            <h3 class="mt-4">⭐ @Model.RatingAverage.ToString("0.0") / 5 · @Model.RatingCount đánh giá</h3>
            @foreach (var review in Model.Reviews)
            {
                <div class="review-card mb-2">
                    <strong>@review.CustomerName</strong>
                    <span class="stars">@(new string('★', review.Rating))</span>
                    <p>@review.Comment</p>
                    <small class="muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                </div>
            }
        </div>
        <aside class="summary-card">
            <div class="price">@Model.BasePrice.VndText()/h</div>
            <p>@Model.Address</p>
            <form method="get">
                <input type="hidden" name="id" value="@Model.Id" />
                <label>Xem lịch ngày</label>
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </form>
            <div class="mt-3">
                @foreach (var slot in Model.Slots)
                {
                    <div class="slot slot-@slot.Status mb-2">@slot.Start – @slot.End · @slot.StatusText · @slot.Price.VndText()</div>
                }
            </div>
            <a class="btn btn-green w-100 mt-3" asp-controller="Booking" asp-action="Create" asp-route-fieldId="@Model.Id" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">Đặt sân</a>
        </aside>
    </div>
</div>
