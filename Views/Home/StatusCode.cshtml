@model int
@{
    ViewData["Title"] = Model.ToString();
    var message = Model switch
    {
        403 => "Bạn không có quyền truy cập trang này.",
        404 => "Không tìm thấy trang bạn yêu cầu.",
        500 => "Hệ thống gặp lỗi. Vui lòng thử lại sau.",
        _ => "Đã xảy ra lỗi khi xử lý yêu cầu."
    };
}
<div class="auth-wrap">
    <div class="auth-card text-center">
        <h1>@Model</h1>
        <p>@message</p>
        <a class="btn btn-green" asp-controller="Home" asp-action="Index">Về trang chủ</a>
    </div>
</div>
